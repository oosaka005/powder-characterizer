[Unit]
Description=Existing Balance SiLA2 Server
# The udev rule aliases the Balance USB device as dev-sila2-balance.device.
# Binding the service to that device stops it when the cable is removed and
# allows udev to start it again when the Balance is reconnected.
BindsTo=dev-sila2-balance.device
After=dev-sila2-balance.device network.target

[Service]
Type=simple
WorkingDirectory=/home/sdl-5/balance_sila_server
ExecStart=/home/sdl-5/balance_sila_server/.venv/bin/python -m balance_server --ip-address 127.0.0.1 --port 50052 --insecure
Restart=on-failure
RestartSec=2
User=sdl-5

[Install]
WantedBy=powder-flow.target
